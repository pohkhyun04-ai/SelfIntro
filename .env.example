# Cloudflare Pages runtime variables
# Add the following in Cloudflare Dashboard > Workers & Pages > your project > Settings > Variables and Secrets.
# Do NOT commit real secrets.

ADMIN_USER=qia
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Leave empty when the frontend and API are in the same Cloudflare Pages project.
VITE_API_BASE=
