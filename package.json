{
  "name": "personal-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A personal portfolio website built with Vue 3, TypeScript, and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist",
    "cf:d1:create": "wrangler d1 create qia-self-db",
    "cf:d1:init": "wrangler d1 execute qia-self-db --remote --file=schema.sql",
    "cf:r2:create": "wrangler r2 bucket create qia-self-avatars",
    "start:prod": "npm run build:prod && cd server && npm run build && npm start",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.136.3"
  }
}
