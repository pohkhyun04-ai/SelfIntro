{
  "name": "personal-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A personal portfolio website built with Vue 3, TypeScript, and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vite build",
    "preview": "vite preview",
    "start:prod": "npm run build:prod && cd server && npm run build && npm start",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
